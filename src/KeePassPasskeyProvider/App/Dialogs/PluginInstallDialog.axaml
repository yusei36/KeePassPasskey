<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
						 xmlns:fa="using:FluentAvalonia.UI.Controls"
						 xmlns:conv="using:KeePassPasskeyProvider.App.Converters"
						 x:Class="KeePassPasskeyProvider.App.Dialogs.PluginInstallDialog"
						 x:DataType="vm:PluginInstallViewModel"
						 Width="460">
		<UserControl.Styles>
				<Style Selector="TextBlock.status">
						<Setter Property="FontWeight" Value="SemiBold" />
						<Setter Property="TextWrapping" Value="Wrap" />
				</Style>
				<Style Selector="TextBlock.status.ok">
						<Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
				</Style>
				<Style Selector="TextBlock.status.error">
						<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</Style>
				<Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
						<Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
				</Style>
				<Style Selector="TextBlock.caption">
						<Setter Property="FontSize" Value="12" />
						<Setter Property="TextWrapping" Value="Wrap" />
						<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
				</Style>
				<Style Selector="TextBlock.path">
						<Setter Property="FontSize" Value="11" />
						<Setter Property="TextTrimming" Value="CharacterEllipsis" />
						<Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
				</Style>
		</UserControl.Styles>

		<StackPanel Spacing="14">

				<StackPanel Spacing="4">
						<TextBlock Text="KeePass folder or plugins folder" Classes="caption" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Grid.Column="0" Text="{Binding SelectedFolder, Mode=TwoWay}"
												 IsEnabled="{Binding !IsBusy}"
												 Classes.invalid="{Binding StatusIsError}">
										<TextBox.InnerRightContent>
												<fa:FAFontIcon Glyph="&#xE783;" FontSize="14" Margin="0 0 8 0"
																			 IsVisible="{Binding StatusIsError}"
																			 Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
										</TextBox.InnerRightContent>
								</TextBox>
								<Button Grid.Column="1" Content="Browse..." Click="OnBrowse"
												IsEnabled="{Binding !IsBusy}" />
						</Grid>
						<TextBlock Text="{Binding DetectionSource}" Classes="caption"
											 IsVisible="{Binding DetectionSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
				</StackPanel>

				<TextBlock Text="{Binding StatusText}" Classes="status"
									 Classes.ok="{Binding StatusIsOk}" Classes.error="{Binding StatusIsError}" />

				<StackPanel Spacing="2">
						<TextBlock Text="{Binding SourceCaption}" Classes="caption" />
						<TextBlock Text="{Binding SourcePath}" Classes="path">
								<ToolTip.Tip>
										<ToolTip MaxWidth="360">
												<TextBlock Text="{Binding SourcePath, Converter={x:Static conv:CharacterWrapConverter.Instance}}"
																	 TextWrapping="Wrap" FontSize="11" />
										</ToolTip>
								</ToolTip.Tip>
						</TextBlock>
				</StackPanel>

				<StackPanel Spacing="2"
										IsVisible="{Binding TargetDllPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
						<TextBlock Text="Installs to" Classes="caption" />
						<TextBlock Text="{Binding TargetDllPath}" Classes="path">
								<ToolTip.Tip>
										<ToolTip MaxWidth="360">
												<TextBlock Text="{Binding TargetDllPath, Converter={x:Static conv:CharacterWrapConverter.Instance}}"
																	 TextWrapping="Wrap" FontSize="11" />
										</ToolTip>
								</ToolTip.Tip>
						</TextBlock>
						<TextBlock Text="This folder does not exist yet and will be created." Classes="caption"
											 Margin="0 4 0 0" IsVisible="{Binding ShowCreateNote}" />
						<TextBlock Text="Writing here needs administrator rights. Windows asks for them once."
											 Classes="caption" Margin="0 4 0 0" IsVisible="{Binding NeedsElevation}" />
				</StackPanel>

				<StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
						<fa:FAProgressRing IsIndeterminate="True" Width="18" Height="18" />
						<TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" />
				</StackPanel>

				<fa:FAInfoBar IsOpen="{Binding ShowResult}" IsClosable="False"
											Severity="{Binding ResultSeverity}" Message="{Binding ResultMessage}" />

				<StackPanel Spacing="6">
						<TextBlock Text="Or copy the file yourself:" Classes="caption" />
						<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Content="Show plugin file" Command="{Binding ShowPluginFileCommand}"
												ToolTip.Tip="Reveal KeePassPasskey.dll in File Explorer" />
								<Button Content="Show target folder" Command="{Binding ShowTargetFolderCommand}"
												IsEnabled="{Binding CanInstall}"
												ToolTip.Tip="Open the KeePass plugins folder in File Explorer" />
						</StackPanel>
				</StackPanel>

		</StackPanel>
</UserControl>
