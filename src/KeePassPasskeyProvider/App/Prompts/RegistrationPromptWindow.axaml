<prompts:PromptWindow xmlns="https://github.com/avaloniaui"
											xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
											xmlns:fa="using:FluentAvalonia.UI.Controls"
											xmlns:prompts="using:KeePassPasskeyProvider.App.Prompts"
											xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
											xmlns:ipc="using:KeePassPasskeyShared.Ipc"
											x:Class="KeePassPasskeyProvider.App.Prompts.RegistrationPromptWindow"
											x:DataType="vm:RegistrationPromptViewModel"
											Title="{Binding WindowTitle}"
											Icon="avares://KeePassPasskeyProvider/Resources/app-icon.png"
											Width="480"
											SizeToContent="Height"
											CanResize="False"
											ShowInTaskbar="False"
											WindowDecorations="None"
											WindowStartupLocation="CenterScreen">

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

		<prompts:PromptTitleBar Grid.Row="0" />

		<!-- Site header -->
		<Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="18 4 18 12">
			<Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
							Background="{Binding SiteTileBrush}">
				<TextBlock Text="{Binding SiteLetter}" Foreground="White"
									 FontSize="16" FontWeight="SemiBold"
									 HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Border>

			<StackPanel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center" Spacing="2">
				<TextBlock Text="{Binding SiteHeadline}" FontSize="14" FontWeight="SemiBold"
									 TextWrapping="Wrap" />
				<TextBlock Text="{Binding SiteSubhead}" IsVisible="{Binding HasSiteSubhead}"
									 FontSize="12" TextTrimming="CharacterEllipsis"
									 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			</StackPanel>
		</Grid>

		<!-- Create new / Add to existing -->
		<Border Grid.Row="2" Margin="18 0 18 0" Padding="3" CornerRadius="6"
						IsVisible="{Binding HasCandidates}"
						Background="{DynamicResource ControlFillColorSecondaryBrush}">
			<Grid ColumnDefinitions="*,*">
				<RadioButton Grid.Column="0" Classes="segment" GroupName="target"
										 Content="Create new" IsChecked="{Binding IsCreateNew, Mode=TwoWay}" />
				<RadioButton Grid.Column="1" Classes="segment" GroupName="target"
										 Content="Add to existing" IsChecked="{Binding IsAddToExisting, Mode=TwoWay}" />
			</Grid>
		</Border>

		<!-- Create a new entry -->
		<StackPanel Grid.Row="3" Margin="18 16 18 4" Spacing="6"
								IsVisible="{Binding IsCreateNew}">
			<TextBlock Text="Database" FontSize="12"
								 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
			<ComboBox HorizontalAlignment="Stretch"
								ItemsSource="{Binding Databases}"
								SelectedItem="{Binding SelectedDatabase}">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="ipc:DatabaseInfo">
						<TextBlock Text="{Binding Name}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<TextBlock Text="A new entry will be created for this site." FontSize="11.5"
								 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
		</StackPanel>

		<!-- Save onto an existing entry -->
		<StackPanel Grid.Row="3" Margin="18 14 18 4" Spacing="8"
								IsVisible="{Binding IsAddToExisting}">
			<Grid ColumnDefinitions="*,6,Auto">
				<TextBox Grid.Column="0" PlaceholderText="Search entries…"
								 Text="{Binding SearchText, Mode=TwoWay}" />
				<ToggleButton Grid.Column="2" Width="32" Height="32" Padding="0"
											IsChecked="{Binding OnlyWithPasskey, Mode=TwoWay}"
											ToolTip.Tip="Show only entries that already have a passkey">
					<fa:FAFontIcon Glyph="&#xE192;" FontSize="16" FontFamily="Segoe Fluent Icons" />
				</ToggleButton>
			</Grid>

			<TextBlock Text="No entries match your search." FontSize="12" Margin="2 6"
								 IsVisible="{Binding !HasVisibleEntries}"
								 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

			<ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
										IsVisible="{Binding HasVisibleEntries}">
				<ItemsControl ItemsSource="{Binding Groups}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:EntryGroupViewModel">
							<StackPanel>
								<Button Classes="groupHeader" Command="{Binding ToggleCommand}">
									<Grid ColumnDefinitions="Auto,*,Auto">
										<fa:FAFontIcon Grid.Column="0" FontSize="10" Margin="0 0 6 0"
																	 FontFamily="Segoe Fluent Icons"
																	 Glyph="&#xE70D;"
																	 IsVisible="{Binding IsExpanded}"
																	 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
										<fa:FAFontIcon Grid.Column="0" FontSize="10" Margin="0 0 6 0"
																	 FontFamily="Segoe Fluent Icons"
																	 Glyph="&#xE76C;"
																	 IsVisible="{Binding !IsExpanded}"
																	 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
										<TextBlock Grid.Column="1" Text="{Binding DatabaseName}"
															 FontSize="12" FontWeight="SemiBold"
															 TextTrimming="CharacterEllipsis" />
										<TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
															 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
									</Grid>
								</Button>

								<ListBox Classes="entryList" Margin="14 0 0 0"
												 IsVisible="{Binding IsExpanded}"
												 ItemsSource="{Binding Items}"
												 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
												 ScrollViewer.VerticalScrollBarVisibility="Disabled">
									<ListBox.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel />
										</ItemsPanelTemplate>
									</ListBox.ItemsPanel>
									<ListBox.ItemTemplate>
										<DataTemplate x:DataType="vm:EntryRowViewModel">
											<Grid ColumnDefinitions="Auto,*">
												<Border Grid.Column="0" Width="24" Height="24" CornerRadius="5"
																Background="{Binding TileBrush}">
													<TextBlock Text="{Binding Letter}" Foreground="White"
																		 FontSize="11" FontWeight="SemiBold"
																		 HorizontalAlignment="Center" VerticalAlignment="Center" />
												</Border>
												<StackPanel Grid.Column="1" Margin="10 0 0 0" Spacing="1">
													<StackPanel Orientation="Horizontal" Spacing="5">
														<TextBlock Text="{Binding Title}" FontSize="12.5"
																			 TextTrimming="CharacterEllipsis" />
														<Border CornerRadius="999" Padding="6 1"
																		IsVisible="{Binding IsKeePassSelected}"
																		Background="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}">
															<TextBlock Text="selected in KeePass" FontSize="10"
																				 Foreground="White" />
														</Border>
														<Border CornerRadius="999" Padding="6 1"
																		IsVisible="{Binding HasPasskey}"
																		Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
															<TextBlock Text="has passkey" FontSize="10"
																				 Foreground="{DynamicResource SystemFillColorCautionBrush}" />
														</Border>
													</StackPanel>
													<TextBlock Text="{Binding Subtitle}" FontSize="11"
																		 TextTrimming="CharacterEllipsis"
																		 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
												</StackPanel>
											</Grid>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</StackPanel>

		<!-- Footer -->
		<Border Grid.Row="4" Margin="0 12 0 0" Padding="18"
						Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
			<Grid ColumnDefinitions="*,10,*">
				<Button Grid.Column="0" Classes="accent" HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								Content="{Binding ConfirmText}"
								IsEnabled="{Binding CanConfirm}"
								Command="{Binding ConfirmCommand}" />
				<Button Grid.Column="2" HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								Content="Cancel"
								Command="{Binding CancelCommand}" />
			</Grid>
		</Border>
	</Grid>
</prompts:PromptWindow>
