<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:loc="using:KeePassPasskeyShared.Localization"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:controls="using:KeePassPasskeyProvider.App.Controls"
						 xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
						 xmlns:utils="using:KeePassPasskeyProvider.App.Utils"
						 x:Class="KeePassPasskeyProvider.App.Pages.DiagnosticsPage"
						 x:DataType="vm:DiagnosticsViewModel">
		<Grid RowDefinitions="Auto,*" Margin="16">
				<TextBlock Grid.Row="0"
									 Text="{x:Static loc:Strings.App_Nav_Diagnostics}"
									 Theme="{StaticResource TitleTextBlockStyle}"
									 Margin="0 0 0 4" />

				<Border Grid.Row="1"
								Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="8"
								Padding="16"
								Margin="0 8 0 0">
						<Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

										<!-- Version warnings -->
										<StackPanel Grid.Row="0" Spacing="8">
												<ui:FAInfoBar Title="{x:Static loc:Strings.App_Diagnostics_IncompatibleVersion_Title}"
																		Message="{Binding IncompatibleVersionMessage}"
																		Severity="Error"
																		IsOpen="{Binding IsIncompatibleVersion}"
																		IsVisible="{Binding IsIncompatibleVersion}"
																		IsClosable="False" />
												<ui:FAInfoBar Title="{x:Static loc:Strings.App_Diagnostics_VersionMismatch_Title}"
																		Message="{Binding VersionMismatchMessage}"
																		Severity="Warning"
																		IsOpen="{Binding IsVersionMismatch}"
																		IsVisible="{Binding IsVersionMismatch}"
																		IsClosable="False" />
										</StackPanel>

										<!-- Versions strip -->
										<Border Grid.Row="1" Padding="4 0 0 12"
														BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
														BorderThickness="0 0 0 1">
												<StackPanel Spacing="6">
														<!-- Provider version row -->
														<Grid ColumnDefinitions="180,*,28" ColumnSpacing="12" VerticalAlignment="Center">
																<TextBlock Grid.Column="0"
																					 Text="{x:Static loc:Strings.App_Label_PasskeyProvider}"
																					 FontFamily="Consolas,Courier New,monospace"
																					 FontSize="12.5" FontWeight="SemiBold"
																					 VerticalAlignment="Center" />
																<Border Grid.Column="1"
																				Background="{DynamicResource ControlFillColorSecondaryBrush}"
																				BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
																				BorderThickness="1" CornerRadius="4" Padding="8 4">
																		<StackPanel Orientation="Horizontal" Spacing="6">
																				<SelectableTextBlock Text="{Binding ClientVersionShort}"
																														 FontFamily="Consolas,Courier New,monospace"
																														 FontSize="11.5" Opacity="0.7" />
																				<Border Background="Transparent"
																								VerticalAlignment="Center"
																								ToolTip.Tip="{x:Static utils:ChannelIcon.Description}"
																								ToolTip.ShowDelay="0">
																						<Path Data="{x:Static utils:ChannelIcon.Geometry}"
																									Fill="{DynamicResource TextFillColorSecondaryBrush}"
																									Stretch="Uniform" Width="12" Height="12" />
																				</Border>
																		</StackPanel>
																</Border>
																<Button Grid.Column="2"
																				Padding="4"
																				Command="{Binding CopyToClipboardCommand}"
																				CommandParameter="{Binding ClientVersionWithChannel}"
																				ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_CopyProviderVersionTooltip}">
																		<ui:FASymbolIcon Symbol="Copy" FontSize="14" />
																</Button>
														</Grid>

														<!-- Plugin version row -->
														<Grid ColumnDefinitions="180,*,28" ColumnSpacing="12" VerticalAlignment="Center">
																<TextBlock Grid.Column="0"
																					 Text="{x:Static loc:Strings.App_Label_KeePassPlugin}"
																					 FontFamily="Consolas,Courier New,monospace"
																					 FontSize="12.5" FontWeight="SemiBold"
																					 VerticalAlignment="Center" />
																<Border Grid.Column="1"
																				Background="{DynamicResource ControlFillColorSecondaryBrush}"
																				BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
																				BorderThickness="1" CornerRadius="4" Padding="8 4">
																		<Panel>
																				<SelectableTextBlock Text="{Binding ServerVersionShort}"
																														 FontFamily="Consolas,Courier New,monospace"
																														 FontSize="11.5" Opacity="0.7"
																														 IsVisible="{Binding IsServerVersionAvailable}" />
																				<TextBlock Text="{x:Static loc:Strings.App_Diagnostics_PluginNotConnected}"
																									 FontFamily="Consolas,Courier New,monospace"
																									 FontSize="11.5" Opacity="0.35"
																									 IsVisible="{Binding IsServerVersionNotAvailable}" />
																		</Panel>
																</Border>
																<Button Grid.Column="2"
																				Padding="4"
																				Command="{Binding CopyToClipboardCommand}"
																				CommandParameter="{Binding ServerVersion}"
																				IsVisible="{Binding IsServerVersionAvailable}"
																				ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_CopyPluginVersionTooltip}">
																		<ui:FASymbolIcon Symbol="Copy" FontSize="14" />
																</Button>
														</Grid>

														<!-- COM Server actions -->
														<Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
																<TextBlock Grid.Column="0"
																					 Text="{x:Static loc:Strings.App_Diagnostics_Registration_Label}"
																					 FontFamily="Consolas,Courier New,monospace"
																					 FontSize="12.5" FontWeight="SemiBold"
																					 VerticalAlignment="Center" />
																<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
																		<Button Content="{x:Static loc:Strings.App_Action_Register}"
																						Command="{Binding RegisterCommand}"
																						Padding="8 3" FontSize="12" />
																		<Button Content="{x:Static loc:Strings.App_Diagnostics_Registration_UnregisterButton}"
																						Command="{Binding UnregisterCommand}"
																						Padding="8 3" FontSize="12" />
																		<Button Content="{x:Static loc:Strings.App_Action_AdvancedPasskeyOptions}"
																						Command="{Binding OpenPasskeySettingsCommand}"
																						ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_Registration_AdvancedOptionsTooltip}"
																						Padding="8 3" FontSize="12" />
																</StackPanel>
														</Grid>

														<!-- Credential cache actions -->
														<Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
																<TextBlock Grid.Column="0"
																					 Text="{x:Static loc:Strings.App_Diagnostics_WindowsCache_Label}"
																					 FontFamily="Consolas,Courier New,monospace"
																					 FontSize="12.5" FontWeight="SemiBold"
																					 VerticalAlignment="Center" />
																<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
																		<Button Content="{x:Static loc:Strings.App_Diagnostics_WindowsCache_SyncButton}"
																						Command="{Binding SyncCredentialsCommand}"
																						ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_WindowsCache_SyncTooltip}"
																						Padding="8 3" FontSize="12" />
																		<Button Content="{x:Static loc:Strings.App_Diagnostics_WindowsCache_DumpButton}"
																						Command="{Binding DumpCredentialsCommand}"
																						ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_WindowsCache_DumpTooltip}"
																						Padding="8 3" FontSize="12" />
																		<Button Content="{x:Static loc:Strings.App_Diagnostics_WindowsCache_ClearButton}"
																						Command="{Binding ClearCredentialsCommand}"
																						ToolTip.Tip="{x:Static loc:Strings.App_Diagnostics_WindowsCache_ClearTooltip}"
																						Padding="8 3" FontSize="12" />
																</StackPanel>
														</Grid>
												</StackPanel>
										</Border>

										<!-- Log -->
										<controls:LogView Grid.Row="2" DataContext="{Binding LogPanel}" />

								</Grid>
						</Border>
		</Grid>
</UserControl>
