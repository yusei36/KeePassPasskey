<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:loc="using:KeePassPasskeyShared.Localization"
						 xmlns:ui="using:FluentAvalonia.UI.Controls"
						 xmlns:vm="using:KeePassPasskeyProvider.App.ViewModel"
			 xmlns:utils="using:KeePassPasskeyProvider.App.Utils"
						 xmlns:conv="using:KeePassPasskeyProvider.App.Converters"
						 x:Class="KeePassPasskeyProvider.App.Pages.SettingsPage"
						 x:DataType="vm:SettingsViewModel"
						 x:CompileBindings="True">

		<Grid RowDefinitions="Auto,*">
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="16 16 16 4">
						<TextBlock Text="{x:Static loc:Strings.App_Nav_Settings}"
											 Theme="{StaticResource TitleTextBlockStyle}" />
						<ui:FASymbolIcon Grid.Column="1" Symbol="ImportantFilled" FontSize="16"
													 VerticalAlignment="Center" Margin="0 0 8 0"
													 IsVisible="{Binding HasUnsavedChanges}"
													 Foreground="{DynamicResource SystemFillColorCautionBrush}"
													 ToolTip.Tip="{x:Static loc:Strings.App_Settings_UnsavedChangesTooltip}" />
						<Button Grid.Column="2"
										Command="{Binding ResetCommand}"
										IsEnabled="{Binding !IsSaving}"
										IsVisible="{Binding HasUnsavedChanges}"
										ToolTip.Tip="{x:Static loc:Strings.App_Settings_DiscardTooltip}"
										VerticalAlignment="Center"
										Margin="0 0 4 0">
								<ui:FASymbolIcon Symbol="Undo" FontSize="18" />
						</Button>
			<Button Grid.Column="3"
										Command="{Binding ResetToDefaultsCommand}"
										IsEnabled="{Binding !IsSaving}"
										IsVisible="{Binding CanResetToDefaults}"
										ToolTip.Tip="{x:Static loc:Strings.App_Settings_ResetToDefaultsTooltip}"
										VerticalAlignment="Center"
										Margin="0 0 4 0">
								<ui:FAFontIcon Glyph="&#xE75C;" FontSize="18" FontFamily="Segoe Fluent Icons" />
			</Button>
						<Button Grid.Column="4"
										Command="{Binding SaveCommand}"
										IsEnabled="{Binding CanSave}"
										ToolTip.Tip="{x:Static loc:Strings.App_Settings_SaveTooltip}"
										VerticalAlignment="Center"
										Classes="accent">
								<ui:FASymbolIcon Symbol="Save" FontSize="18" />
						</Button>
				</Grid>
				<ScrollViewer Grid.Row="1">
				<StackPanel Spacing="8" Margin="16 8 16 16">

						<Border IsVisible="{Binding LoadFailed}"
										Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
										CornerRadius="4" Padding="12 8">
								<StackPanel Orientation="Horizontal" Spacing="8">
										<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																		 Foreground="{DynamicResource SystemFillColorCautionBrush}"
																		 VerticalAlignment="Center" />
										<TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
															 Text="{x:Static loc:Strings.App_Settings_LoadFailed}" />
								</StackPanel>
						</Border>

						<ui:FAInfoBar Title="{x:Static loc:Strings.App_Settings_Enforced_Title}"
													Message="{x:Static loc:Strings.App_Settings_Enforced_Message}"
													Severity="Warning"
													IsOpen="{Binding SettingsEnforced}"
													IsVisible="{Binding SettingsEnforced}"
													IsClosable="False" />

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_Appearance_Header}"
																 IconSource="DarkTheme"
																 Description="{x:Static loc:Strings.App_Settings_Appearance_Description}"
																 IsExpanded="True">
								<ui:FASettingsExpander.Footer>
										<ComboBox SelectedItem="{Binding Theme}"
															ItemsSource="{Binding Themes}"
															MinWidth="120">
												<ComboBox.ItemTemplate>
														<DataTemplate>
																<TextBlock Text="{Binding Converter={x:Static conv:ThemeConverters.Text}}" />
														</DataTemplate>
												</ComboBox.ItemTemplate>
										</ComboBox>
								</ui:FASettingsExpander.Footer>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_Language_Header}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding SelectedLanguage}"
																	ItemsSource="{Binding Languages}"
																	MinWidth="160">
														<ComboBox.ItemTemplate>
																<DataTemplate x:DataType="vm:LanguageOption">
																		<TextBlock Text="{Binding DisplayName}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_TrayIcon_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_TrayIcon_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding EnableTrayIcon}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_Verification_Header}"
																 IconSource="OtherUser"
																 Description="{x:Static loc:Strings.App_Settings_Verification_Description}"
																 IsExpanded="True">

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_ErrorNotifications_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_ErrorNotifications_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding ShowErrorNotifications}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_ApprovalTimeout_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_ApprovalTimeout_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ui:FANumberBox Value="{Binding NotificationTimeoutSeconds}"
																			Minimum="5"
																			Maximum="300"
																			SmallChange="5"
																			ValidationMode="InvalidInputOverwritten"
																			SpinButtonPlacementMode="Inline"
																			MinWidth="120"
									  NumberFormatter="{x:Static utils:NumberFormatters.Seconds}" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}">
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="0" Margin="0 4">
														<StackPanel Spacing="2" Margin="0 0 0 6">
																<StackPanel Orientation="Horizontal" Spacing="8">
																		<TextBlock Text="{x:Static loc:Strings.App_Settings_RegistrationVerification_Header}" VerticalAlignment="Center" />
																		<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																				VerticalAlignment="Center"
																				IsVisible="{Binding IsRegistrationSilent}"
																				Foreground="{DynamicResource SystemFillColorCautionBrush}"
																				ToolTip.Tip="{x:Static loc:Strings.App_Settings_Verification_SilentWarning}" />
																</StackPanel>
																<TextBlock Text="{x:Static loc:Strings.App_Settings_RegistrationVerification_Description}"
																		Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																		FontSize="12" />
														</StackPanel>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Verification_WindowsHello}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding RegistrationWindowsHello}" MinHeight="0"
																		OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																		OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}" />
														</Grid>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Verification_Prompt}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding RegistrationPrompt}" MinHeight="0"
																		OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																		OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}" />
														</Grid>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}">
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="0" Margin="0 4">
														<StackPanel Spacing="2" Margin="0 0 0 6">
																<StackPanel Orientation="Horizontal" Spacing="8">
																		<TextBlock Text="{x:Static loc:Strings.App_Settings_SignInVerification_Header}" VerticalAlignment="Center" />
																		<ui:FASymbolIcon Symbol="ImportantFilled" FontSize="16"
																				VerticalAlignment="Center"
																				IsVisible="{Binding IsSignInSilent}"
																				Foreground="{DynamicResource SystemFillColorCautionBrush}"
																				ToolTip.Tip="{x:Static loc:Strings.App_Settings_Verification_SilentWarning}" />
																</StackPanel>
																<TextBlock Text="{x:Static loc:Strings.App_Settings_SignInVerification_Description}"
																		Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																		FontSize="12" />
														</StackPanel>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Verification_WindowsHello}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding SignInWindowsHello}" MinHeight="0"
																		OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																		OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}" />
														</Grid>
														<Grid ColumnDefinitions="*,Auto">
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Verification_Prompt}" VerticalAlignment="Center" />
																<ToggleSwitch Grid.Column="1" IsChecked="{Binding SignInPrompt}" MinHeight="0"
																		OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																		OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}" />
														</Grid>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_SkipHelloAfterUnlock_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_SkipHelloAfterUnlock_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SkipWindowsHelloAfterUnlock}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_Entries_Header}"
																 IconSource="Save"
																 Description="{x:Static loc:Strings.App_Settings_Entries_Description}"
																 IsExpanded="True">

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_EntryGroup_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_EntryGroup_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding NewEntryGroupMode}"
																	ItemsSource="{Binding GroupModes}"
																	MinWidth="160">
														<ComboBox.ItemTemplate>
																<DataTemplate>
																		<TextBlock Text="{Binding Converter={x:Static conv:PasskeyEntryGroupModeConverters.Text}}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_EntryTitle_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_EntryTitle_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<TextBox Text="{Binding EntryTitleTemplate}"
																 PlaceholderText="{}{RP_NAME} (Passkey)"
																 Width="240" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_ResolvePlaceholders_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_ResolvePlaceholders_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding ResolveTitlePlaceholders}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_TagEntries_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_TagEntries_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding AddPasskeyTag}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_DuplicateCheck_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_DuplicateCheck_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding ExcludeCredentialCheckMode}"
																	ItemsSource="{Binding ExcludeCredentialCheckModes}"
																	MinWidth="200">
														<ComboBox.ItemTemplate>
																<DataTemplate>
																		<TextBlock Text="{Binding Converter={x:Static conv:ExcludeCredentialCheckModeConverters.Text}}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_Advanced_Header}"
																 IconSource="Setting"
																 Description="{x:Static loc:Strings.App_Settings_Advanced_Description}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_LogLevel_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_LogLevel_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ComboBox SelectedItem="{Binding LogLevel}"
																	ItemsSource="{Binding LogLevels}"
																	MinWidth="120">
														<ComboBox.ItemTemplate>
																<DataTemplate>
																		<TextBlock Text="{Binding Converter={x:Static conv:LogLevelConverters.Text}}" />
																</DataTemplate>
														</ComboBox.ItemTemplate>
												</ComboBox>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_RefreshInterval_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_RefreshInterval_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ui:FANumberBox Value="{Binding StatusRefreshIntervalSeconds}"
																			Minimum="1"
																			Maximum="3600"
																			SmallChange="5"
																			ValidationMode="InvalidInputOverwritten"
																			SpinButtonPlacementMode="Inline"
																			MinWidth="120"
									  NumberFormatter="{x:Static utils:NumberFormatters.Seconds}" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_SaveToExisting_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_SaveToExisting_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SaveToExistingEntry}"
																			IsEnabled="{Binding IsSaveToExistingEntryAvailable}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_PluginUpdates_Header}"
																			 Description="{x:Static loc:Strings.App_Settings_PluginUpdates_Description}">
									<ui:FASettingsExpanderItem.Footer>
											<ToggleSwitch IsChecked="{Binding CheckForPluginUpdates}"
																OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																Margin="0 0 4 0" />
									</ui:FASettingsExpanderItem.Footer>
							</ui:FASettingsExpanderItem>

							<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_LegacyPrompts_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_LegacyPrompts_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding UseLegacyNotificationPrompts}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_Expert_Header}"
																 IconSource="Important"
																 Description="{x:Static loc:Strings.App_Settings_Expert_Description}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_WindowsCache_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_WindowsCache_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding SyncCredentialsToWindows}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_BackupEligibility_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_BackupEligibility_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding NewPasskeyBackupEligible}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}" Content="{x:Static loc:Strings.App_Settings_BackupState_Header}"
																				 Description="{x:Static loc:Strings.App_Settings_BackupState_Description}">
										<ui:FASettingsExpanderItem.Footer>
												<ToggleSwitch IsChecked="{Binding NewPasskeyBackupState}"
																			IsEnabled="{Binding NewPasskeyBackupEligible}"
																			OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																			OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																			Margin="0 0 4 0" />
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsEnabled="{Binding !SettingsEnforced}">
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="8" Margin="0 4">
														<Grid ColumnDefinitions="*,Auto">
																<StackPanel Spacing="2" VerticalAlignment="Center" Margin="0 0 16 0">
																		<TextBlock Text="{x:Static loc:Strings.App_Settings_Algorithms_Header}" />
																		<TextBlock Text="{x:Static loc:Strings.App_Settings_Algorithms_Description}"
																							 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																							 FontSize="12"
																							 TextWrapping="Wrap" />
																</StackPanel>
																<ComboBox Grid.Column="1"
																					SelectedItem="{Binding AlgorithmSelectionMode}"
																					ItemsSource="{Binding AlgorithmSelectionModes}"
																					VerticalAlignment="Center"
																					MinWidth="220">
																		<ComboBox.ItemTemplate>
																				<DataTemplate>
																						<TextBlock Text="{Binding Converter={x:Static conv:AlgorithmSelectionModeConverters.Text}}" />
																				</DataTemplate>
																		</ComboBox.ItemTemplate>
																</ComboBox>
														</Grid>
														<ItemsControl ItemsSource="{Binding AlgorithmPreferences}">
																<ItemsControl.ItemTemplate>
																		<DataTemplate x:DataType="vm:AlgorithmPreferenceViewModel">
																				<Grid ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="32">
																						<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
																								<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
																								<TextBlock Text="{Binding Description}"
																													 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																													 FontSize="12"
																													 VerticalAlignment="Center" />
																						</StackPanel>
																						<Button Grid.Column="1"
																										Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveAlgorithmUpCommand}"
																										CommandParameter="{Binding}"
																										IsEnabled="{Binding CanMoveUp}"
																										IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).IsAlgorithmOrderEditable}"
																										ToolTip.Tip="{x:Static loc:Strings.App_Settings_Algorithms_MoveUpTooltip}"
																										Padding="8 3"
																										VerticalAlignment="Center"
																										Margin="0 0 4 0">
																								<ui:FAFontIcon Glyph="&#xE70E;" FontSize="14" FontFamily="Segoe Fluent Icons" />
																						</Button>
																						<Button Grid.Column="2"
																										Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveAlgorithmDownCommand}"
																										CommandParameter="{Binding}"
																										IsEnabled="{Binding CanMoveDown}"
																										IsVisible="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).IsAlgorithmOrderEditable}"
																										ToolTip.Tip="{x:Static loc:Strings.App_Settings_Algorithms_MoveDownTooltip}"
																										Padding="8 3"
																										VerticalAlignment="Center"
																										Margin="0 0 8 0">
																								<ui:FAFontIcon Glyph="&#xE70D;" FontSize="14" FontFamily="Segoe Fluent Icons" />
																						</Button>
																						<ToggleSwitch Grid.Column="3"
																													IsChecked="{Binding Enabled}"
																													IsEnabled="{Binding CanToggle}"
																													OnContent="{x:Static loc:Strings.App_Settings_ToggleOn}"
																													OffContent="{x:Static loc:Strings.App_Settings_ToggleOff}"
																													VerticalAlignment="Center"
																													Margin="0 -6 4 -6" />
																				</Grid>
																		</DataTemplate>
																</ItemsControl.ItemTemplate>
														</ItemsControl>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem IsVisible="{Binding IsAaguidSpoofingAllowed}">
										<ui:FASettingsExpanderItem.Content>
												<StackPanel Spacing="8" Margin="0 4">
														<StackPanel Spacing="2">
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Aaguid_Header}" />
																<TextBlock Text="{x:Static loc:Strings.App_Settings_Aaguid_Description}"
																					 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																					 FontSize="12"
																					 TextWrapping="Wrap" />
														</StackPanel>
														<StackPanel Orientation="Horizontal" Spacing="6">
																<TextBox Text="{Binding SpoofAaguid}"
																				 PlaceholderText="{Binding DefaultAaguidText}"
																				 IsEnabled="{Binding !IsApplyingAaguid}"
																				 Width="330"
																				 FontFamily="Cascadia Mono, Consolas, monospace"
																				 VerticalAlignment="Center" />
																<Button Command="{Binding ClearAaguidCommand}"
																				IsEnabled="{Binding !IsApplyingAaguid}"
																				ToolTip.Tip="{x:Static loc:Strings.App_Settings_Aaguid_ClearTooltip}"
																				VerticalAlignment="Center">
																		<ui:FAFontIcon Glyph="&#xE75C;" FontSize="16" FontFamily="Segoe Fluent Icons" />
																</Button>
																<Button Content="{x:Static loc:Strings.App_Settings_Aaguid_ApplyButton}"
																				Command="{Binding ApplyAaguidCommand}"
																				Classes="accent"
																				VerticalAlignment="Center" />
														</StackPanel>
														<TextBlock Text="{Binding SpoofAaguidError}"
																			 IsVisible="{Binding !IsSpoofAaguidValid}"
																			 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
																			 TextWrapping="Wrap"
																			 FontSize="12" />
														<TextBlock Text="{Binding SpoofAaguidStatus}"
																			 IsVisible="{Binding SpoofAaguidStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
																			 Foreground="{DynamicResource SystemFillColorSuccessBrush}"
																			 TextWrapping="Wrap"
																			 FontSize="12" />
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

						<ui:FASettingsExpander Header="{x:Static loc:Strings.App_Settings_About_Header}"
																 IconSource="Help"
																 Description="{x:Static loc:Strings.App_Settings_About_Description}"
																 IsExpanded="False">

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_Copyright}"
																				 Description="{x:Static loc:Strings.App_Settings_About_CopyrightNotice}" />

								<ui:FASettingsExpanderItem>
										<ui:FASettingsExpanderItem.Content>
												<StackPanel>
														<TextBlock Text="{x:Static loc:Strings.App_Settings_About_Version}" />
														<StackPanel Orientation="Horizontal" Spacing="6" Margin="0 1 0 0">
																<TextBlock Text="{Binding AppVersion}"
																					 FontSize="12"
																					 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
																					 VerticalAlignment="Center" />
																<Button x:Name="VerifyReleaseButton"
																				Command="{Binding VerifyReleaseCommand}"
																				VerticalAlignment="Center"
																				Padding="0"
																				Background="Transparent"
																				BorderBrush="Transparent"
																				BorderThickness="0"
																				ToolTip.Tip="{Binding VerifyReleaseMessage}"
																				ToolTip.ShowDelay="0">
																		<Button.Styles>
																				<Style Selector="Button:pointerover /template/ ContentPresenter">
																						<Setter Property="Background" Value="Transparent" />
																				</Style>
																				<Style Selector="Button:pressed /template/ ContentPresenter">
																						<Setter Property="Background" Value="Transparent" />
																				</Style>
																		</Button.Styles>
																		<Path Data="{x:Static utils:ChannelIcon.Geometry}"
																					Fill="{DynamicResource TextFillColorSecondaryBrush}"
																					Stretch="Uniform" Width="11" Height="11" />
																</Button>
														</StackPanel>
												</StackPanel>
										</ui:FASettingsExpanderItem.Content>
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding CopyToClipboardCommand}"
																CommandParameter="{Binding AppVersionFull}"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_CopyVersionTooltip}">
														<ui:FASymbolIcon Symbol="Copy" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_Website}"
																				 Description="keepasspasskey.github.io">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://keepasspasskey.github.io"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_WebsiteTooltip}">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_SourceCode}"
																				 Description="github.com/yusei36/KeePassPasskey">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_SourceCodeTooltip}">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_Contributors}"
																				 Description="github.com/yusei36/KeePassPasskey/graphs/contributors">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey/graphs/contributors"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_ContributorsTooltip}">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_ReportBug}"
																				 Description="github.com/yusei36/KeePassPasskey/issues">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenUrlCommand}"
																CommandParameter="https://github.com/yusei36/KeePassPasskey/issues"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_ReportBugTooltip}">
														<ui:FASymbolIcon Symbol="Globe" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_License}"
																				 Description="{x:Static loc:Strings.App_Settings_About_LicenseName}"
																				 IsVisible="{Binding HasLicense}">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenLicenseCommand}"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_LicenseTooltip}">
														<ui:FASymbolIcon Symbol="Document" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

								<ui:FASettingsExpanderItem Content="{x:Static loc:Strings.App_Settings_About_ThirdParty}"
																				 Description="{x:Static loc:Strings.App_Settings_About_ThirdPartyDescription}"
																				 IsVisible="{Binding HasThirdPartyNotices}">
										<ui:FASettingsExpanderItem.Footer>
												<Button Command="{Binding OpenThirdPartyNoticesCommand}"
																ToolTip.Tip="{x:Static loc:Strings.App_Settings_About_ThirdPartyTooltip}">
														<ui:FASymbolIcon Symbol="Document" FontSize="14" />
												</Button>
										</ui:FASettingsExpanderItem.Footer>
								</ui:FASettingsExpanderItem>

						</ui:FASettingsExpander>

				</StackPanel>
		</ScrollViewer>

				<!-- Blocks interaction while settings load from KeePass on page entry. -->
				<Border Grid.Row="0" Grid.RowSpan="2"
								IsVisible="{Binding IsLoading}"
								Background="{DynamicResource SmokeFillColorDefaultBrush}">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
								<ui:FAProgressRing IsIndeterminate="True" Width="48" Height="48"
																	 HorizontalAlignment="Center" />
								<TextBlock Text="{x:Static loc:Strings.App_Settings_Loading}" HorizontalAlignment="Center" />
						</StackPanel>
				</Border>
		</Grid>

</UserControl>
