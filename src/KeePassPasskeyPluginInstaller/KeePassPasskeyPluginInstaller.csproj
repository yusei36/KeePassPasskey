<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>KeePassPasskey.Installer</RootNamespace>
		<AssemblyName>KeePassPasskeyPluginInstaller</AssemblyName>
		<!-- Own folder: Invoke-ILRepack globs build\$(Configuration)\*.dll. -->
		<OutputPath>..\..\build\$(Configuration)\PluginInstaller\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Deterministic>true</Deterministic>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Title>KeePassPasskey Plugin Installer</Title>
		<Description>Elevation helper that installs the KeePassPasskey plugin into the KeePass plugins folder.</Description>
		<Product>KeePass Plugin</Product>
	</PropertyGroup>

	<!-- Linked rather than referenced: this exe has to stay a single dependency-free file. -->
	<ItemGroup>
		<Compile Include="..\KeePassPasskeyPlugin\ProviderPackageLocator.cs" Link="Shared\ProviderPackageLocator.cs" />
		<Compile Include="..\KeePassPasskeyPlugin\Update\PluginInstaller.cs" Link="Shared\PluginInstaller.cs" />
		<Compile Include="..\KeePassPasskeyShared\Ipc\PipeConstants.cs" Link="Shared\PipeConstants.cs" />
	</ItemGroup>

</Project>
